# EC2 의 /opt/checkin/.env 로 복사해 값을 채운다. 저장소에 올리지 않는다.
# 팀 채팅(DM)으로만 주고받는다.

GHCR_OWNER=ynkite
DOMAIN=checkin.example.kr

# DB — 아무 문자열이나 길게
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 기존 application.properties 에 넣던 값 그대로
JWT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_JS_KEY=
KAKAO_REST_KEY=
KAKAO_ADMIN_KEY=
WEATHER_API_KEY=
TOUR_API_KEY=
TMAP_APP_KEY=
SK_PUZZLE_KEY=
SK_PUZZLE_API_KEY=
OPINET_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_KEY=
ANTHROPIC_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@checkin.example.kr
