# ============================================================
# application-local.properties 템플릿 (로컬 개발용)
#
#   이 파일을 그대로 복사만 하면 앱이 뜬다.
#     copy application-local.properties.example application-local.properties
#
#   DB 계정이 root / 빈 비밀번호가 아니면 아래 두 줄만 바꾸거나
#   환경변수 DB_USER · DB_PASSWORD 를 설정한다.
# ============================================================

# ---------- DB ----------
# DB 이름은 각자 다르게 쓴다 (스키마 충돌 방지). 예: checkin_ysy / checkin_lsh
spring.datasource.url=jdbc:mariadb://localhost:3306/${DB_NAME:checkin}?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&createDatabaseIfNotExist=true
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:}

# ---------- 서버 ----------
# 로컬 개발은 전원 8080 고정 (서버 배포는 8081)
# 예외: 워크트리 2개를 동시에 띄울 때만 두 번째를 8090 으로 (checkin-b)
server.port=${SERVER_PORT:8080}

# ---------- OAuth 리다이렉트 ----------
# 포트를 바꾸면 이 줄도 같이 바뀌어야 한다 → ${SERVER_PORT} 로 묶어 뒀다
spring.security.oauth2.client.registration.google.redirect-uri=http://localhost:${SERVER_PORT:8080}/login/oauth2/code/google

# ---------- 업로드 경로 ----------
# 기본은 프로젝트 안 uploads/ (gitignore 대상). 다른 곳에 두려면 절대경로로 바꾼다
file.upload.path=${UPLOAD_PATH:./uploads/}
